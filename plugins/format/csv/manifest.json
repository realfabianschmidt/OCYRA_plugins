{
  "id": "format-plugin-csv",
  "name": "CSV",
  "version": "0.1.0",
  "plugin_api_version": 1,
  "role": "format",
  "runtime": {
    "mode": "quickjs"
  },
  "entry": "handler.js",
  "capabilities": [],
  "limits": {
    "maxBatchItems": 100000,
    "maxInputBytes": 33554432,
    "maxOutputBytes": 33554432,
    "timeoutMs": 5000,
    "memoryBytes": 268435456
  },
  "description": "Import and export translation tables as CSV.",
  "family": "format",
  "format": {
    "target": "document-tabular",
    "directions": [
      "import",
      "export"
    ],
    "extensions": [
      "csv"
    ]
  },
  "binary": false,
  "locales": {
    "en": "locales/en.json",
    "de": "locales/de.json",
    "fr": "locales/fr.json"
  }
}
