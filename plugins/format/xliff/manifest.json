{
  "id": "format-plugin-xliff",
  "name": "XLIFF",
  "version": "0.1.0",
  "plugin_api_version": 1,
  "role": "format",
  "runtime": {
    "mode": "quickjs"
  },
  "entry": "handler.js",
  "capabilities": [],
  "limits": {
    "maxBatchItems": 50000,
    "maxInputBytes": 8388608,
    "maxOutputBytes": 8388608,
    "timeoutMs": 5000,
    "memoryBytes": 67108864
  },
  "description": "Import and export XLIFF 1.2 and 2.x localization files.",
  "family": "format",
  "format": {
    "target": "document-tabular",
    "directions": [
      "import",
      "export"
    ],
    "extensions": [
      "xlf",
      "xliff"
    ]
  },
  "binary": false,
  "locales": {
    "en": "locales/en.json",
    "de": "locales/de.json",
    "fr": "locales/fr.json"
  }
}
